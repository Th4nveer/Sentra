{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/src/api/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/api/app.py"
    },
    {
      "src": "/reports/(.*)",
      "dest": "backend/src/api/app.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "backend/src/api/app.py"
    },
    {
      "src": "/docs",
      "dest": "backend/src/api/app.py"
    },
    {
      "src": "/openapi.json",
      "dest": "backend/src/api/app.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
