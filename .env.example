# Sentra Configuration Environment Variables

# Groq API Key for tender document extraction
GROQ_API_KEY=your_groq_api_key_here

# Optional: Planet Scope / Planet-NICFI API Key for high-resolution satellite imagery
PLANET_API_KEY=your_planet_api_key_here

# Nominatim User Agent for OpenStreetMap geocoding
GEOLOCATION_USER_AGENT=Sentra-Satellite-Audit/1.0

# Application Settings
SENTRA_ENV=development
SENTRA_PORT=8050
SENTRA_HOST=127.0.0.1
CACHE_DIR=./data/satellite_cache
REPORTS_DIR=./data/reports

# Backend CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public frontend URL (shown in API root response)
FRONTEND_URL=http://localhost:5173
