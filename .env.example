# Sentra Configuration Environment Variables

# Gemini API Key for tender document extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Planet Scope / Planet-NICFI API Key for high-resolution satellite imagery
PLANET_API_KEY=your_planet_api_key_here

# Nominatim User Agent for OpenStreetMap geocoding
GEOLOCATION_USER_AGENT=Sentra-Satellite-Audit/1.0

# Application Settings
SENTRA_ENV=development
SENTRA_PORT=8050
SENTRA_HOST=127.0.0.1
CACHE_DIR=./data/satellite_cache
REPORTS_DIR=./data/reports
